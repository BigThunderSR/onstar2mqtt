# OnStar2MQTT Environment Configuration
# Copy this file to .env and fill in your actual values
#
# NOTE: This format works with both Node.js and Docker
# Values are unquoted for maximum compatibility

# OnStar Configuration
# Required: Your OnStar account credentials
ONSTAR_VIN=1HGBH41JXMN109186
ONSTAR_USERNAME=your_onstar_username
ONSTAR_PASSWORD=your_onstar_password
ONSTAR_TOTP=your_totp_secret_key  # Required; if TOTP setup is unavailable, see Firefox token procedure in README
ONSTAR_PIN=1234

# Token Storage (HIGHLY RECOMMENDED)
# Saves authentication tokens to avoid repeated login challenges
# For local Node.js: Leave empty to use current directory
# For Docker: Set to /app/tokens and use -v ~/onstar2mqtt-tokens:/app/tokens
# REQUIRED when using the Firefox token procedure (place microsoft_tokens.json here)
TOKEN_LOCATION=""

# Optional: OnStar settings
ONSTAR_DEVICEID=""
ONSTAR_SYNC=true
ONSTAR_REFRESH=1800000
ONSTAR_POLL_INTERVAL=6
ONSTAR_POLL_TIMEOUT=90
ONSTAR_ALLOW_COMMANDS=true

# MQTT Configuration
# Required: MQTT broker connection
MQTT_HOST=localhost
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# Optional: MQTT settings
MQTT_PORT=1883
MQTT_TLS=false
MQTT_REJECT_UNAUTHORIZED=true
MQTT_PREFIX=homeassistant
MQTT_NAME_PREFIX=""
MQTT_ONSTAR_POLLING_STATUS_TOPIC=""
MQTT_LIST_ALL_SENSORS_TOGETHER=false

# Optional: MQTT TLS Certificate files
MQTT_CA_FILE=""
MQTT_CERT_FILE=""
MQTT_KEY_FILE=""

# Optional: Logging
LOG_LEVEL=info

# === Troubleshooting: sharing logs & capturing diagnostics ===
# Two independent tools below: (1) LOG_REDACT scrubs your normal logs; (2) the
# Dump Diagnostics button captures a one-off raw diagnostics payload on demand.
# Which do I use? Sharing a FULL console log -> set LOG_REDACT=true. Sharing just
# ONE diagnostics snapshot/fixture -> press Dump Diagnostics (its file is redacted
# by default). Gotcha: the button only redacts the dump payload, not surrounding
# log lines — paste the whole console only with LOG_REDACT=true.

# (1) Redact PII from ALL ongoing log output (VIN, device ID, credentials, account
#     number, vehicle ID, email, phone, GPS) so logs can be shared without manual
#     editing. Does not affect the Dump Diagnostics button. Default: false
LOG_REDACT=false

# (2) The "Dump Diagnostics" button is auto-added to Home Assistant (enabled by
#     default). Press it to pull fresh diagnostics and print the raw response for
#     troubleshooting or for contributing test fixtures. Nothing dumps automatically
#     — only the button. The three settings below apply only to it:

#   Redact the button's dump? Default true (safe to share); false = raw dump.
#   (If LOG_REDACT=true above, the dump is redacted regardless of this setting.)
ONSTAR_DUMP_BUTTON_REDACT=true
#   Where the button writes: log (console only) | file | both (console + a file).
ONSTAR_DIAGNOSTIC_DUMP=log
#   Directory for the file copy (file/both). Falls back to UNIT_CACHE_DIR, then
#   TOKEN_LOCATION, then the current directory.
ONSTAR_DIAGNOSTIC_DUMP_DIR=""
